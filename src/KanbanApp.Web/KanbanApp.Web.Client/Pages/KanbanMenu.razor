@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject KanbanApp.Web.Client.Services.AuthService AuthService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Kanban Pro</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>

        @if (_isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="boards">
                    My Boards
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="teams">
                    👥 Teams
                </NavLink>
            </div>

            @if (_isOnBoard)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="boards">
                        ← All Boards
                    </NavLink>
                </div>
            }

            @if (_isAdmin)
            {
                <div class="nav-item px-3 mt-2">
                    <NavLink class="nav-link text-warning" href="admin" style="font-weight: 500;">
                        <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> Admin Panel
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3 mt-4">
                <NavLink class="nav-link" href="profile">
                    <span aria-hidden="true">👤</span> Profile
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100 text-muted" @onclick="Logout">
                    Logout
                </button>
            </div>
        }
        else if (!_loading)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    Log In
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    Register
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool _isAuthenticated = false;
    private bool _isAdmin = false;
    private bool _loading = true;
    private bool _isOnBoard = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        Nav.LocationChanged += OnLocationChanged;
        await RefreshAuthState();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await RefreshAuthState();
    }

    private async Task RefreshAuthState()
    {
        var token = await LocalStorage.GetItemAsStringAsync("authToken");
        _isAuthenticated = !string.IsNullOrWhiteSpace(token);
        _isOnBoard = Nav.Uri.Contains("/board/");
        
        // Strict role check — must read from auth state provider
        if (_isAuthenticated)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAdmin = authState.User.IsInRole("Admin");
        }
        else
        {
            _isAdmin = false;
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}