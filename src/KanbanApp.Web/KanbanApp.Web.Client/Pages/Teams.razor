@page "/teams"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using KanbanApp.Application.DTOs
@using KanbanApp.Web.Client.Services
@inject KanbanApiService ApiService
@inject NavigationManager Nav

<PageTitle>My Teams — Kanban Pro</PageTitle>

<div class="teams-page">
    <div class="teams-header">
        <div>
            <h2 class="teams-title">👥 My Teams</h2>
            <p class="teams-subtitle">Collaborate with your colleagues on shared boards</p>
        </div>
        <button class="btn-create-team" @onclick="() => showCreateModal = true">
            + Create Team
        </button>
    </div>

    @if (teams == null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <span>Loading teams...</span>
        </div>
    }
    else if (!teams.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">👥</div>
            <h3>No teams yet</h3>
            <p>Create a team to start collaborating with others on shared boards.</p>
            <button class="btn-create-team" @onclick="() => showCreateModal = true">Create your first team</button>
        </div>
    }
    else
    {
        <div class="teams-grid">
            @foreach (var team in teams)
            {
                <div class="team-card" @onclick="@(() => Nav.NavigateTo("/team/" + team.Id))">
                    <div class="team-card-avatar">@team.Name[0]</div>
                    <div class="team-card-body">
                        <h3 class="team-card-name">@team.Name</h3>
                        @if (!string.IsNullOrEmpty(team.Description))
                        {
                            <p class="team-card-desc">@team.Description</p>
                        }
                        <div class="team-card-meta">
                            <span class="meta-badge">👤 @team.MemberCount members</span>
                            <span class="meta-badge">📋 @team.BoardCount boards</span>
                        </div>
                    </div>
                    <div class="team-card-arrow">→</div>
                </div>
            }
        </div>
    }
</div>

@* ── Create Team Modal ─────────────────────────────────────────── *@
@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false"></div>
    <div class="modal-box">
        <div class="modal-box-header">
            <h5>Create New Team</h5>
            <button class="modal-close" @onclick="() => showCreateModal = false">✕</button>
        </div>
        <div class="modal-box-body">
            <div class="field">
                <label>Team Name *</label>
                <input type="text" @bind="newTeamName" placeholder="e.g. Design Squad" maxlength="100" />
            </div>
            <div class="field">
                <label>Description</label>
                <textarea @bind="newTeamDesc" rows="3" placeholder="What does this team work on?"></textarea>
            </div>
            @if (createError != null)
            {
                <div class="field-error">@createError</div>
            }
        </div>
        <div class="modal-box-footer">
            <button class="btn-cancel" @onclick="() => showCreateModal = false">Cancel</button>
            <button class="btn-confirm" @onclick="CreateTeam" disabled="@isCreating">
                @(isCreating ? "Creating..." : "Create Team")
            </button>
        </div>
    </div>
}

<style>
    .teams-page {
        padding: 32px;
        max-width: 900px;
        margin: 0 auto;
    }

    .teams-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
    }

    .teams-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        color: #172b4d;
    }

    .teams-subtitle {
        color: #6b778c;
        margin: 6px 0 0;
    }

    .btn-create-team {
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        white-space: nowrap;
    }

    .btn-create-team:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 82, 204, 0.35);
    }

    .teams-grid {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .team-card {
        background: white;
        border-radius: 12px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        cursor: pointer;
        border: 1px solid #e8ecf0;
        transition: box-shadow 0.2s, transform 0.15s;
    }

    .team-card:hover {
        box-shadow: 0 4px 20px rgba(0,0,0,0.10);
        transform: translateY(-2px);
        border-color: #0052cc;
    }

    .team-card-avatar {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #0052cc, #6554c0);
        color: white;
        font-size: 22px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .team-card-body {
        flex: 1;
        min-width: 0;
    }

    .team-card-name {
        font-size: 17px;
        font-weight: 700;
        margin: 0 0 4px;
        color: #172b4d;
    }

    .team-card-desc {
        font-size: 13px;
        color: #6b778c;
        margin: 0 0 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .team-card-meta {
        display: flex;
        gap: 8px;
    }

    .meta-badge {
        font-size: 12px;
        background: #f4f5f7;
        color: #5e6c84;
        padding: 3px 8px;
        border-radius: 20px;
        font-weight: 500;
    }

    .team-card-arrow {
        color: #b3bac5;
        font-size: 18px;
    }

    .loading-state {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #6b778c;
        padding: 40px 0;
    }

    .spinner {
        width: 24px;
        height: 24px;
        border: 3px solid #e8ecf0;
        border-top-color: #0052cc;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #6b778c;
    }

    .empty-icon {
        font-size: 56px;
        margin-bottom: 16px;
    }

    .empty-state h3 {
        font-size: 22px;
        color: #172b4d;
        margin-bottom: 8px;
    }

    .empty-state p {
        margin-bottom: 24px;
    }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(9, 30, 66, 0.54);
        z-index: 1040;
    }

    .modal-box {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1050;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 460px;
        overflow: hidden;
    }

    .modal-box-header {
        padding: 20px 24px 16px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-box-header h5 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #172b4d;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 16px;
        color: #6b778c;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .modal-close:hover { background: #f4f5f7; }

    .modal-box-body { padding: 20px 24px; }

    .field {
        margin-bottom: 16px;
    }

    .field label {
        display: block;
        font-weight: 600;
        font-size: 13px;
        color: #172b4d;
        margin-bottom: 6px;
    }

    .field input, .field textarea, .field select {
        width: 100%;
        border: 2px solid #dfe1e6;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

    .field input:focus, .field textarea:focus {
        border-color: #0052cc;
    }

    .field-error {
        background: #ffebe6;
        color: #de350b;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 13px;
        margin-top: 8px;
    }

    .modal-box-footer {
        padding: 16px 24px 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .btn-cancel {
        background: #f4f5f7;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        color: #5e6c84;
    }

    .btn-confirm {
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-confirm:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-confirm:hover:not(:disabled) { opacity: 0.9; }
    /* ── Responsive ────────────────────────────────────────────── */
    @@media (max-width: 640px) {
        .teams-page { padding: 16px; }

        .teams-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 20px;
        }

        .teams-title { font-size: 22px; }

        .btn-create-team { width: 100%; text-align: center; }

        .team-card { padding: 14px 16px; gap: 12px; }

        .team-card-avatar { width: 42px; height: 42px; font-size: 18px; border-radius: 10px; }

        .modal-box { max-width: calc(100% - 24px); }
        .modal-box-header, .modal-box-body, .modal-box-footer { padding-left: 16px; padding-right: 16px; }
    }
</style>

@code {
    private List<TeamDto>? teams;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private string newTeamName = string.Empty;
    private string newTeamDesc = string.Empty;
    private string? createError;

    protected override async Task OnInitializedAsync()
    {
        try { teams = await ApiService.GetMyTeamsAsync(); }
        catch { teams = []; }
    }

    private async Task CreateTeam()
    {
        if (string.IsNullOrWhiteSpace(newTeamName))
        {
            createError = "Team name is required.";
            return;
        }

        isCreating = true;
        createError = null;

        var result = await ApiService.CreateTeamAsync(new CreateTeamDto
        {
            Name        = newTeamName.Trim(),
            Description = string.IsNullOrWhiteSpace(newTeamDesc) ? null : newTeamDesc.Trim()
        });

        if (result != null)
        {
            showCreateModal = false;
            newTeamName = string.Empty;
            newTeamDesc = string.Empty;
            Nav.NavigateTo($"/team/{result.Id}");
        }
        else
        {
            createError = "Failed to create team. Please try again.";
        }

        isCreating = false;
    }
}
