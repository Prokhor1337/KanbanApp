@page "/join/{Code:guid}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using KanbanApp.Application.DTOs
@using KanbanApp.Web.Client.Services
@inject KanbanApiService ApiService
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Join Team — Kanban Pro</PageTitle>

<div class="join-page">
    <div class="join-card">

        @if (loading)
        {
            <div class="join-loading">
                <div class="spinner"></div>
                <span>Loading invite...</span>
            </div>
        }
        else if (invalid)
        {
            <div class="join-icon error-icon">❌</div>
            <h2 class="join-title">Invalid Invite Link</h2>
            <p class="join-subtitle">This invite link is invalid or has been revoked by the team owner.</p>
            <a href="/teams" class="btn-primary-lg">Browse My Teams</a>
        }
        else if (joined)
        {
            <div class="join-icon success-icon">🎉</div>
            <h2 class="join-title">You're in!</h2>
            <p class="join-subtitle">You've successfully joined <strong>@teamInfo!.TeamName</strong>. Welcome to the team!</p>
            <button class="btn-primary-lg btn-join" @onclick="@(() => Nav.NavigateTo("/team/" + teamInfo!.TeamId))">
                Open Team →
            </button>
        }
        else if (teamInfo != null)
        {
            <div class="team-invite-avatar">@teamInfo.TeamName[0]</div>
            <h2 class="join-title">You're invited to join</h2>
            <h3 class="join-team-name">@teamInfo.TeamName</h3>
            @if (!string.IsNullOrEmpty(teamInfo.Description))
            {
                <p class="join-team-desc">@teamInfo.Description</p>
            }
            <div class="join-meta">
                <span class="meta-pill">👤 @teamInfo.MemberCount members</span>
            </div>

            @if (!isLoggedIn)
            {
                <div class="join-auth-hint">
                    <p>You need to log in to join this team.</p>
                    <div style="display:flex;gap:12px;justify-content:center;">
                        <a href="/login" class="btn-primary-lg">Log In</a>
                        <a href="/register" class="btn-outline-lg">Register</a>
                    </div>
                </div>
            }
            else
            {
                <button class="btn-primary-lg btn-join" @onclick="Join" disabled="@isJoining">
                    @(isJoining ? "Joining..." : "Join Team")
                </button>
                @if (joinError != null)
                {
                    <div class="join-error">@joinError</div>
                }
            }
        }

    </div>
</div>

<style>
    .join-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 100%);
        padding: 24px;
    }

    .join-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 82, 204, 0.12);
        padding: 48px 40px;
        max-width: 440px;
        width: 100%;
        text-align: center;
    }

    .join-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: #6b778c;
        padding: 20px 0;
    }

    .join-icon {
        font-size: 56px;
        margin-bottom: 16px;
        display: block;
    }

    .team-invite-avatar {
        width: 72px; height: 72px;
        border-radius: 18px;
        background: linear-gradient(135deg, #0052cc, #6554c0);
        color: white; font-size: 32px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 24px;
        text-transform: uppercase;
    }

    .join-title {
        font-size: 22px;
        font-weight: 700;
        color: #172b4d;
        margin: 0 0 4px;
    }

    .join-team-name {
        font-size: 26px;
        font-weight: 800;
        color: #0052cc;
        margin: 4px 0 12px;
    }

    .join-team-desc {
        font-size: 14px;
        color: #6b778c;
        margin-bottom: 16px;
        line-height: 1.5;
    }

    .join-meta {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 28px;
    }

    .meta-pill {
        font-size: 13px;
        background: #f4f5f7;
        color: #5e6c84;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .join-subtitle {
        font-size: 15px;
        color: #6b778c;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    .btn-primary-lg {
        display: inline-block;
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        border: none;
        padding: 14px 32px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 12px rgba(0, 82, 204, 0.3);
    }

    .btn-primary-lg:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(0, 82, 204, 0.4);
        color: white;
    }

    .btn-primary-lg:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .btn-outline-lg {
        display: inline-block;
        background: white;
        color: #0052cc;
        border: 2px solid #0052cc;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.15s;
    }

    .btn-outline-lg:hover { background: #e8f0fe; color: #0052cc; }

    .btn-join { width: 100%; }

    .join-auth-hint {
        background: #f4f5f7;
        border-radius: 12px;
        padding: 20px;
        margin-top: 8px;
    }

    .join-auth-hint p {
        color: #6b778c;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .join-error {
        background: #ffebe6;
        color: #de350b;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        margin-top: 12px;
    }

    .spinner {
        width: 24px; height: 24px;
        border: 3px solid #e8ecf0;
        border-top-color: #0052cc;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    [Parameter] public Guid Code { get; set; }

    private TeamInviteInfoDto? teamInfo;
    private bool loading = true;
    private bool invalid = false;
    private bool joined = false;
    private bool isJoining = false;
    private bool isLoggedIn = false;
    private string? joinError;

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsStringAsync("authToken");
        isLoggedIn = !string.IsNullOrWhiteSpace(token);

        teamInfo = await ApiService.GetInviteInfoAsync(Code);

        if (teamInfo == null)
            invalid = true;

        loading = false;
    }

    private async Task Join()
    {
        isJoining = true;
        joinError = null;

        var teamId = await ApiService.JoinViaInviteCodeAsync(Code);
        if (teamId != null)
        {
            joined = true;
        }
        else
        {
            joinError = "Failed to join team. The link may have been revoked.";
        }

        isJoining = false;
    }
}
