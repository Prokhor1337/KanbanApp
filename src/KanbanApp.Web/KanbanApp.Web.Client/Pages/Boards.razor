@page "/boards"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using KanbanApp.Application.DTOs
@using KanbanApp.Web.Client.Services
@inject KanbanApiService ApiService
@inject NavigationManager Nav

<PageTitle>My Boards — Kanban Pro</PageTitle>

<div class="boards-page">
    <div class="boards-header">
        <div>
            <h2 class="boards-title">📋 My Boards</h2>
            <p class="boards-subtitle">Manage your personal Kanban boards</p>
        </div>
        <button class="btn-new-board" @onclick="() => showCreateForm = !showCreateForm">
            @(showCreateForm ? "✕ Cancel" : "+ New Board")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-error">@errorMessage</div>
    }

    @* Create Form *@
    @if (showCreateForm)
    {
        <div class="create-form-card">
            <h5 class="create-form-title">Create New Board</h5>
            <div class="create-form-fields">
                <input @bind="newBoard.Title" class="field-input" placeholder="Board title *"
                       @onkeydown="OnTitleKeyDown" />
                <input @bind="newBoard.Description" class="field-input" placeholder="Description (optional)" />
            </div>
            <div class="create-form-actions">
                <button class="btn-create-confirm" @onclick="CreateBoard"
                        disabled="@(string.IsNullOrWhiteSpace(newBoard.Title) || isCreating)">
                    @(isCreating ? "Creating..." : "Create Board")
                </button>
                <button class="btn-create-cancel" @onclick="() => { showCreateForm = false; newBoard = new(); }">
                    Cancel
                </button>
            </div>
        </div>
    }

    @* Boards Grid *@
    @if (boards == null)
    {
        <div class="boards-loading">
            <div class="spinner"></div>
            <span>Loading boards...</span>
        </div>
    }
    else if (boards.Count == 0)
    {
        <div class="boards-empty">
            <div class="empty-icon">📋</div>
            <h3>No boards yet</h3>
            <p>Create your first board to start organizing tasks.</p>
            <button class="btn-new-board" @onclick="() => showCreateForm = true">Create your first board</button>
        </div>
    }
    else
    {
        <div class="boards-grid">
            @foreach (var board in boards)
            {
                <div class="board-card">
                    <div class="board-card-color-bar"></div>
                    <div class="board-card-body">
                        <h4 class="board-card-title">@board.Title</h4>
                        <p class="board-card-desc">
                            @(string.IsNullOrEmpty(board.Description) ? "No description." : board.Description)
                        </p>
                        <div class="board-card-date">
                            Created @board.CreatedAt.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                        </div>
                    </div>
                    <div class="board-card-footer">
                        <button class="btn-open" @onclick="@(() => Nav.NavigateTo("/board/" + board.Id))">
                            Open →
                        </button>
                        <button class="btn-delete-board" title="Delete board"
                                @onclick="() => AskDelete(board)">
                            🗑
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Delete Confirmation Modal *@
@if (boardToDelete != null)
{
    <div class="modal-backdrop" @onclick="CancelDelete"></div>
    <div class="modal-box">
        <div class="modal-box-header">
            <h5>🗑 Delete Board?</h5>
            <button class="modal-close" @onclick="CancelDelete">✕</button>
        </div>
        <div class="modal-box-body">
            <p>Are you sure you want to delete <strong>@boardToDelete.Title</strong>?</p>
            <p class="delete-warning">All columns and cards inside will be permanently deleted.</p>
        </div>
        <div class="modal-box-footer">
            <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
            <button class="btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                @(isDeleting ? "Deleting..." : "Yes, Delete")
            </button>
        </div>
    </div>
}

<style>
    /* ── Page ──────────────────────────────────────────────────── */
    .boards-page {
        padding: 28px 28px 40px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .boards-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 28px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .boards-title {
        font-size: 26px;
        font-weight: 700;
        margin: 0;
        color: #172b4d;
    }

    .boards-subtitle {
        color: #6b778c;
        margin: 6px 0 0;
        font-size: 14px;
    }

    .btn-new-board {
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .btn-new-board:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 82, 204, 0.35);
    }

    .alert-error {
        background: #ffebe6;
        color: #de350b;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-weight: 600;
        font-size: 14px;
    }

    /* ── Create Form ───────────────────────────────────────────── */
    .create-form-card {
        background: white;
        border: 1px solid #e8ecf0;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 28px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        max-width: 480px;
    }

    .create-form-title {
        font-size: 16px;
        font-weight: 700;
        color: #172b4d;
        margin: 0 0 16px;
    }

    .create-form-fields {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 16px;
    }

    .field-input {
        width: 100%;
        border: 2px solid #dfe1e6;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

    .field-input:focus { border-color: #0052cc; }

    .create-form-actions {
        display: flex;
        gap: 10px;
    }

    .btn-create-confirm {
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        border: none;
        padding: 9px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-create-confirm:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-create-confirm:hover:not(:disabled) { opacity: 0.9; }

    .btn-create-cancel {
        background: #f4f5f7;
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        color: #5e6c84;
    }

    /* ── Loading / Empty ───────────────────────────────────────── */
    .boards-loading {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #6b778c;
        padding: 40px 0;
    }

    .spinner {
        width: 24px; height: 24px;
        border: 3px solid #e8ecf0;
        border-top-color: #0052cc;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    .boards-empty {
        text-align: center;
        padding: 60px 20px;
        color: #6b778c;
    }

    .empty-icon { font-size: 52px; margin-bottom: 16px; }

    .boards-empty h3 {
        font-size: 20px;
        color: #172b4d;
        margin-bottom: 8px;
    }

    .boards-empty p { margin-bottom: 24px; }

    /* ── Board Cards ───────────────────────────────────────────── */
    .boards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
    }

    .board-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #e8ecf0;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: box-shadow 0.2s, transform 0.15s;
    }

    .board-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }

    .board-card-color-bar {
        height: 5px;
        background: linear-gradient(90deg, #0052cc, #6554c0);
    }

    .board-card-body {
        padding: 16px 16px 12px;
        flex: 1;
    }

    .board-card-title {
        font-size: 16px;
        font-weight: 700;
        color: #172b4d;
        margin: 0 0 8px;
        word-break: break-word;
    }

    .board-card-desc {
        font-size: 13px;
        color: #6b778c;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
    }

    .board-card-date {
        font-size: 11px;
        color: #97a0af;
    }

    .board-card-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px 14px;
        border-top: 1px solid #f4f5f7;
    }

    .btn-open {
        flex: 1;
        background: #0052cc;
        color: white;
        border: none;
        padding: 8px 0;
        border-radius: 7px;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-open:hover { opacity: 0.85; }

    .btn-delete-board {
        background: #f4f5f7;
        border: 1px solid #dfe1e6;
        color: #97a0af;
        padding: 7px 10px;
        border-radius: 7px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .btn-delete-board:hover {
        background: #ffebe6;
        border-color: #ffbdad;
        color: #de350b;
    }

    /* ── Delete Modal ──────────────────────────────────────────── */
    .modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(9, 30, 66, 0.54); z-index: 1040;
    }

    .modal-box {
        position: fixed; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1050; background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: calc(100% - 32px); max-width: 420px;
    }

    .modal-box-header {
        padding: 18px 20px 14px;
        border-bottom: 1px solid #f0f0f0;
        display: flex; justify-content: space-between; align-items: center;
    }

    .modal-box-header h5 {
        margin: 0; font-size: 17px; font-weight: 700; color: #172b4d;
    }

    .modal-close {
        background: none; border: none; font-size: 15px;
        color: #6b778c; cursor: pointer; padding: 4px 8px; border-radius: 4px;
    }

    .modal-close:hover { background: #f4f5f7; }

    .modal-box-body {
        padding: 16px 20px;
        font-size: 14px;
        color: #172b4d;
        line-height: 1.5;
    }

    .modal-box-body p { margin: 0 0 8px; }

    .delete-warning { color: #6b778c; font-size: 13px; }

    .modal-box-footer {
        padding: 12px 20px 18px;
        display: flex; justify-content: flex-end; gap: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .btn-cancel {
        background: #f4f5f7; border: none;
        padding: 9px 16px; border-radius: 8px;
        font-weight: 600; font-size: 13px;
        cursor: pointer; color: #5e6c84;
    }

    .btn-danger {
        background: #de350b; color: white; border: none;
        padding: 9px 18px; border-radius: 8px;
        font-weight: 700; font-size: 13px;
        cursor: pointer; transition: opacity 0.2s;
    }

    .btn-danger:hover:not(:disabled) { opacity: 0.85; }
    .btn-danger:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── Responsive ────────────────────────────────────────────── */
    @@media (max-width: 600px) {
        .boards-page { padding: 16px; }
        .boards-title { font-size: 20px; }
        .boards-header { margin-bottom: 20px; }
        .boards-grid { grid-template-columns: 1fr; }
        .btn-new-board { width: 100%; text-align: center; }
    }
</style>

@code {
    private List<BoardDto>? boards;
    private CreateBoardDto newBoard = new();
    private string errorMessage = string.Empty;
    private bool _loaded = false;
    private bool showCreateForm = false;
    private bool isCreating = false;

    // Delete
    private BoardDto? boardToDelete;
    private bool isDeleting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded = true;
        try
        {
            await LoadBoards();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private async Task LoadBoards()
    {
        boards = await ApiService.GetBoardsAsync();
    }

    private async Task OnTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newBoard.Title))
            await CreateBoard();
    }

    private async Task CreateBoard()
    {
        if (string.IsNullOrWhiteSpace(newBoard.Title)) return;
        isCreating = true;
        errorMessage = string.Empty;
        try
        {
            var created = await ApiService.CreateBoardAsync(newBoard);
            if (created != null)
            {
                newBoard = new CreateBoardDto();
                showCreateForm = false;
                await LoadBoards();
            }
            else
            {
                errorMessage = "Failed to create board. The server rejected the request.";
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        isCreating = false;
    }

    // ── Delete ─────────────────────────────────────────────────
    private void AskDelete(BoardDto board) => boardToDelete = board;
    private void CancelDelete() => boardToDelete = null;

    private async Task ConfirmDelete()
    {
        if (boardToDelete == null) return;
        isDeleting = true;
        var ok = await ApiService.DeleteBoardAsync(boardToDelete.Id);
        if (ok)
        {
            boardToDelete = null;
            await LoadBoards();
        }
        else
        {
            errorMessage = "Failed to delete board.";
            boardToDelete = null;
        }
        isDeleting = false;
    }
}