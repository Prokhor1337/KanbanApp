@page "/admin"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using KanbanApp.Application.DTOs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject KanbanApp.Web.Client.Services.KanbanApiService ApiService
@inject KanbanApp.Web.Client.Services.ToastService Toast

<PageTitle>Admin Dashboard — Kanban Pro</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="admin-page">
            <div class="admin-header">
                <div>
                    <h2 class="admin-title">🛡 Admin Dashboard</h2>
                    <p class="admin-subtitle">Manage all boards across the system</p>
                </div>
                <div class="admin-stats">
                    <span class="stat-badge">📋 @(allBoards?.Count ?? 0) total boards</span>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="admin-loading">
                    <div class="spinner"></div>
                    <span>Loading boards...</span>
                </div>
            }
            else if (allBoards == null || !allBoards.Any())
            {
                <div class="admin-empty">No boards found in the system.</div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Board Title</th>
                                <th>Description</th>
                                <th>Owner</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var board in allBoards)
                            {
                                <tr>
                                    <td class="td-title">@board.Title</td>
                                    <td class="td-desc">
                                        @(string.IsNullOrEmpty(board.Description) ? "—" : board.Description)
                                    </td>
                                    <td class="td-owner">@board.OwnerId</td>
                                    <td class="td-date">
                                        @board.CreatedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
                                    </td>
                                    <td class="td-actions">
                                        <a href="/board/@board.Id" class="btn-view">View</a>
                                        <button class="btn-admin-delete" title="Delete board"
                                                @onclick="() => AskDelete(board)">
                                            🗑 Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="access-denied">
            <div class="access-denied-icon">🔒</div>
            <h3>Access Denied</h3>
            <p>You must be an administrator to view this page.</p>
            <a href="/" class="btn-home">← Go Home</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@* Delete Confirmation Modal *@
@if (boardToDelete != null)
{
    <div class="modal-backdrop" @onclick="CancelDelete"></div>
    <div class="modal-box">
        <div class="modal-box-header">
            <h5>🗑 Delete Board?</h5>
            <button class="modal-close" @onclick="CancelDelete">✕</button>
        </div>
        <div class="modal-box-body">
            <p>Are you sure you want to permanently delete <strong>@boardToDelete.Title</strong>?</p>
            <p class="delete-warning">All columns and cards will be lost. This action cannot be undone.</p>
        </div>
        <div class="modal-box-footer">
            <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
            <button class="btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                @(isDeleting ? "Deleting..." : "Yes, Delete")
            </button>
        </div>
    </div>
}

<style>
    /* ── Page ──────────────────────────────────────────────────── */
    .admin-page {
        padding: 28px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .admin-title {
        font-size: 26px;
        font-weight: 700;
        margin: 0;
        color: #172b4d;
    }

    .admin-subtitle {
        color: #6b778c;
        margin: 6px 0 0;
        font-size: 14px;
    }

    .admin-stats {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .stat-badge {
        background: #f4f5f7;
        color: #5e6c84;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .admin-loading {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #6b778c;
        padding: 40px 0;
    }

    .admin-empty {
        color: #6b778c;
        padding: 40px 0;
        font-size: 15px;
    }

    /* ── Table ─────────────────────────────────────────────────── */
    .table-wrapper {
        background: white;
        border-radius: 14px;
        border: 1px solid #e8ecf0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        overflow: hidden;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .admin-table thead tr {
        background: #172b4d;
        color: white;
    }

    .admin-table th {
        padding: 13px 16px;
        text-align: left;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .admin-table tbody tr {
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

    .admin-table tbody tr:last-child { border-bottom: none; }
    .admin-table tbody tr:hover { background: #f8f9fa; }

    .admin-table td {
        padding: 12px 16px;
        vertical-align: middle;
        color: #172b4d;
    }

    .td-title { font-weight: 600; min-width: 160px; }
    .td-desc { color: #6b778c; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .td-owner { font-family: monospace; font-size: 11px; color: #97a0af; max-width: 120px; overflow: hidden; text-overflow: ellipsis; }
    .td-date { white-space: nowrap; color: #6b778c; font-size: 13px; }
    .td-actions { white-space: nowrap; }

    .btn-view {
        display: inline-block;
        background: #e8f0fe;
        color: #0052cc;
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
        text-decoration: none;
        margin-right: 6px;
        transition: background 0.2s;
    }

    .btn-view:hover { background: #cce0ff; color: #0052cc; }

    .btn-admin-delete {
        background: #ffebe6;
        color: #de350b;
        border: 1px solid #ffbdad;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-admin-delete:hover { background: #ffccc2; border-color: #ff8f73; }

    /* ── Access Denied ─────────────────────────────────────────── */
    .access-denied {
        text-align: center;
        padding: 80px 20px;
    }

    .access-denied-icon { font-size: 56px; margin-bottom: 16px; }

    .access-denied h3 {
        font-size: 22px;
        color: #de350b;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .access-denied p { color: #6b778c; margin-bottom: 24px; }

    .btn-home {
        display: inline-block;
        background: #0052cc;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .btn-home:hover { opacity: 0.85; color: white; }

    /* ── Modal ─────────────────────────────────────────────────── */
    .modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(9, 30, 66, 0.54); z-index: 1040;
    }

    .modal-box {
        position: fixed; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1050; background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: calc(100% - 32px); max-width: 420px;
    }

    .modal-box-header {
        padding: 18px 20px 14px;
        border-bottom: 1px solid #f0f0f0;
        display: flex; justify-content: space-between; align-items: center;
    }

    .modal-box-header h5 { margin: 0; font-size: 17px; font-weight: 700; color: #172b4d; }

    .modal-close {
        background: none; border: none; font-size: 15px;
        color: #6b778c; cursor: pointer; padding: 4px 8px; border-radius: 4px;
    }

    .modal-close:hover { background: #f4f5f7; }

    .modal-box-body {
        padding: 16px 20px;
        font-size: 14px; color: #172b4d; line-height: 1.5;
    }

    .modal-box-body p { margin: 0 0 8px; }
    .delete-warning { color: #6b778c; font-size: 13px; }

    .modal-box-footer {
        padding: 12px 20px 18px;
        display: flex; justify-content: flex-end; gap: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .btn-cancel {
        background: #f4f5f7; border: none;
        padding: 9px 16px; border-radius: 8px;
        font-weight: 600; font-size: 13px;
        cursor: pointer; color: #5e6c84;
    }

    .btn-danger {
        background: #de350b; color: white; border: none;
        padding: 9px 18px; border-radius: 8px;
        font-weight: 700; font-size: 13px;
        cursor: pointer; transition: opacity 0.2s;
    }

    .btn-danger:hover:not(:disabled) { opacity: 0.85; }
    .btn-danger:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── Spinner ───────────────────────────────────────────────── */
    .spinner {
        width: 24px; height: 24px;
        border: 3px solid #e8ecf0;
        border-top-color: #0052cc;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Responsive ────────────────────────────────────────────── */
    @@media (max-width: 640px) {
        .admin-page { padding: 16px; }
        .admin-title { font-size: 20px; }
        .td-owner, .td-date { display: none; }
    }
</style>

@code {
    private List<BoardDto>? allBoards;
    private bool isLoading = true;

    // Delete
    private BoardDto? boardToDelete;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allBoards = await ApiService.GetAllBoardsAsync();
            Toast.ShowSuccess("Boards loaded successfully.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Server error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AskDelete(BoardDto board) => boardToDelete = board;
    private void CancelDelete() => boardToDelete = null;

    private async Task ConfirmDelete()
    {
        if (boardToDelete == null) return;
        isDeleting = true;

        var ok = await ApiService.DeleteBoardAsync(boardToDelete.Id);
        if (ok)
        {
            Toast.ShowSuccess($"Board \"{boardToDelete.Title}\" deleted.");
            allBoards?.Remove(boardToDelete);
            boardToDelete = null;
        }
        else
        {
            Toast.ShowError("Failed to delete board.");
            boardToDelete = null;
        }

        isDeleting = false;
    }
}