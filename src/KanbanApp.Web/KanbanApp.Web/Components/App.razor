<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="KanbanApp.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Update home page CTA buttons based on auth token
        // Runs on both initial load and Blazor enhanced navigation
        function updateHomeButtons() {
            try {
                var token = localStorage.getItem('authToken');
                var loggedIn = token && token !== 'null' && token.length > 10;
                var boards = document.getElementById('cta-boards');
                var reg = document.getElementById('cta-register');
                var login = document.getElementById('cta-login');
                if (!boards) return; // not on home page
                boards.style.display = loggedIn ? 'inline-flex' : 'none';
                if (reg) reg.style.display = loggedIn ? 'none' : 'inline-flex';
                if (login) login.style.display = loggedIn ? 'none' : 'inline-flex';
            } catch (e) { }
        }
        // Initial load
        document.addEventListener('DOMContentLoaded', updateHomeButtons);
        // After every Blazor enhanced navigation
        document.addEventListener('blazor:navigated', updateHomeButtons);
    </script>
</body>

</html>
