<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="KanbanApp.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        (function () {
            function updateHomeButtons() {
                try {
                    var token = localStorage.getItem('authToken');
                    var loggedIn = token && token !== 'null' && token.length > 10;
                    var boards = document.getElementById('cta-boards');
                    if (!boards) return; // not on home page
                    var reg = document.getElementById('cta-register');
                    var login = document.getElementById('cta-login');
                    boards.style.display = loggedIn ? 'inline-flex' : 'none';
                    if (reg) reg.style.display = loggedIn ? 'none' : 'inline-flex';
                    if (login) login.style.display = loggedIn ? 'none' : 'inline-flex';
                } catch (e) { }
            }

            // 1. Initial full page load
            document.addEventListener('DOMContentLoaded', updateHomeButtons);

            // 2. After Blazor enhanced navigation — defer to NEXT tick so DOM is ready
            document.addEventListener('blazor:navigated', function () {
                setTimeout(updateHomeButtons, 0);
            });

            // 3. MutationObserver backup — triggers when home page elements appear in DOM
            var observer = new MutationObserver(function () {
                if (document.getElementById('cta-boards')) {
                    updateHomeButtons();
                }
            });
            document.addEventListener('DOMContentLoaded', function () {
                observer.observe(document.body, { childList: true, subtree: true });
            });
        })();
    </script>
</body>

</html>
