@page "/"

<PageTitle>Kanban Pro - Manage Tasks Efficiently</PageTitle>

<div class="home-hero">
    <div class="home-hero-inner">
        <div class="home-badge">✨ Kanban for Developers</div>
        <h1 class="home-title">
            Organize your work,<br />
            <span class="home-title-accent">one board at a time.</span>
        </h1>
        <p class="home-desc">
            A simple, fast, and secure Kanban board for developers and teams.
            Keep track of your tasks, move them seamlessly, and stay productive.
        </p>
        <div class="home-cta">
            <a href="/boards" id="cta-boards" class="btn-hero-primary" style="display:none">📋 Go to My Boards</a>
            <a href="/register" id="cta-register" class="btn-hero-primary">🚀 Get Started for Free</a>
            <a href="/login" id="cta-login" class="btn-hero-ghost">Log In</a>
        </div>

        <div class="home-features">
            <div class="feature-card">
                <div class="feature-icon">🎯</div>
                <h3>Visual Workflow</h3>
                <p>Drag and drop tasks between columns instantly. See the big picture at a glance.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔐</div>
                <h3>Secure Access</h3>
                <p>JWT authentication and ASP.NET Core Identity keep your data safe.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3>Blazing Fast</h3>
                <p>Built with Blazor WebAssembly for a near-native single-page experience.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">👥</div>
                <h3>Team Collaboration</h3>
                <p>Create teams, share boards, and collaborate in real time with SignalR.</p>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        try {
            var t = localStorage.getItem('authToken');
            if (t && t !== 'null' && t.length > 10) {
                var b = document.getElementById('cta-boards');
                var r = document.getElementById('cta-register');
                var l = document.getElementById('cta-login');
                if (b) b.style.display = 'inline-flex';
                if (r) r.style.display = 'none';
                if (l) l.style.display = 'none';
            }
        } catch (e) { }
    })();
</script>

<style>
    .home-hero {
        min-height: 100vh;
        background: linear-gradient(145deg, #f8f9ff 0%, #eef1fb 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .home-hero-inner {
        max-width: 900px;
        width: 100%;
        padding: 60px 24px 80px;
        text-align: center;
    }

    .home-badge {
        display: inline-block;
        background: linear-gradient(135deg, #0052cc, #0065ff);
        color: white;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 20px;
        margin-bottom: 24px;
    }

    .home-title {
        font-size: clamp(32px, 6vw, 58px);
        font-weight: 900;
        color: #172b4d;
        line-height: 1.15;
        margin: 0 0 20px;
        letter-spacing: -1px;
    }

    .home-title-accent {
        background: linear-gradient(135deg, #0052cc, #5b7ef7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .home-desc {
        font-size: clamp(15px, 2vw, 18px);
        color: #6b778c;
        max-width: 560px;
        margin: 0 auto 36px;
        line-height: 1.6;
    }

    .home-cta {
        display: flex;
        gap: 14px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 72px;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #0052cc 0%, #0065ff 100%);
        color: white !important;
        font-size: 15px;
        font-weight: 700;
        padding: 14px 28px;
        border-radius: 12px;
        text-decoration: none !important;
        box-shadow: 0 4px 16px rgba(0,82,204,0.35);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-hero-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,82,204,0.45);
        color: white !important;
    }

    .btn-hero-ghost {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        color: #0052cc !important;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 24px;
        border-radius: 12px;
        text-decoration: none !important;
        border: 2px solid #0052cc;
        transition: all 0.2s;
    }

    .btn-hero-ghost:hover {
        background: #0052cc;
        color: white !important;
        transform: translateY(-1px);
    }

    .home-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        text-align: left;
    }

    .feature-card {
        background: white;
        border-radius: 16px;
        padding: 24px 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        border: 1px solid #eaedf0;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.09);
    }

    .feature-icon { font-size: 28px; margin-bottom: 12px; }

    .feature-card h3 {
        font-size: 15px;
        font-weight: 700;
        color: #172b4d;
        margin: 0 0 8px;
    }

    .feature-card p {
        font-size: 13px;
        color: #6b778c;
        margin: 0;
        line-height: 1.5;
    }

    @media (max-width: 640px) {
        .home-hero-inner { padding: 40px 16px 60px; }
        .home-cta { gap: 10px; }
        .btn-hero-primary, .btn-hero-ghost {
            width: 100%;
            justify-content: center;
            padding: 14px 20px;
        }
    }
</style>